{
  "name": "@hostr/mcp-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:local": "./scripts/dev-local.sh",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test:unit": "npm run build && node --test test/*.test.mjs",
    "test:ai:e2e": "node scripts/codex-ai-e2e.mjs",
    "test:ai:e2e:supervised": "node scripts/codex-ai-e2e.mjs --supervised",
    "test:ai:e2e:smoke": "node scripts/codex-ai-e2e.mjs --mode smoke",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.8.2",
    "npm": ">=12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
